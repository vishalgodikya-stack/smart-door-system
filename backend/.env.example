# Copy this file to .env and fill in your values

# Secret key for JWT signing (generate with: openssl rand -hex 32)
SECRET_KEY=your_super_secret_key_here_change_this

# Internal token for Raspberry Pi face_watcher -> FastAPI auto-unlock
BACKEND_TOKEN=your_internal_backend_token_here

# Public/Tunnel base URL for serving visitor & authorized person images
BASE_URL=https://your-pi-hostname.ts.net

# JWT expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database path
DATABASE_URL=sqlite:///./smart_door.db

# Images storage directory
IMAGES_DIR=./images

# Admin setup (first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password_here

# GPIO pin for door lock TIP122 driver (Raspberry Pi 4 BCM numbering)
DOOR_GPIO_PIN=18

# Face recognition distance threshold (lower = stricter)
FACE_RECOGNITION_TOLERANCE=0.6
